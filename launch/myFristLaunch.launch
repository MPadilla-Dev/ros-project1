<launch>
<node name="talker" pkg="first_demo" type="demo_topic_publisher" output="screen">
	<remap from="numbers" to="group/num"/>
	<param name="N_num" value="0"/>
</node>
<!--Node 2-->
<node name="listener" pkg="first_demo" type="demo_topic_subscriber" output="screen">
	<remap from="numbers" to="group/num"/>
</node>
</launch>
